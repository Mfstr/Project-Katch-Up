# The Supabase API URL. 
# For local dev via `npx supabase start`, use the URL outputted by the CLI (usually http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# The Supabase Anon / Publishable key.
# For local dev via `npx supabase start`, use the anon key outputted by the CLI.
SUPABASE_ANON_KEY=your_local_anon_key_here

# Backend server port
PORT=5050

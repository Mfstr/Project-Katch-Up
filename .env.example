# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: Supabase service_role secret key (Project Settings -> API -> service_role)
# Grants backend access to bypass Row Level Security and manage users directly.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Backend server port
PORT=5050

# Feature Flags (true/false)
# Set to false to disable routes and return 503 Service Unavailable
ENABLE_CALENDAR=true

# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: Supabase service_role secret key (Project Settings -> API -> service_role)
# Grants backend access to bypass Row Level Security and manage users directly.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Port the API server listens on (docs/TestEndpointManually.txt assumes 5050)
PORT=5050

# Feature Flags (true/false)
# Set to false to disable routes and return 503 Service Unavailable
ENABLE_CALENDAR=true

# Comma-separated list of browser origins allowed to call the API (CORS).
# Production: the Vercel site, e.g. https://project-katch-up.vercel.app
# Defaults to the Vite dev server (http://localhost:5173) when unset.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (Render = 1). Used for per-visitor rate limiting.
# TRUST_PROXY_HOPS=1
